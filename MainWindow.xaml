
<Window x:Class="WpfApp4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp4"
        mc:Ignorable="d"
        BorderThickness="1"
        BorderBrush="White"
        WindowStartupLocation="CenterScreen"
        Title="Sklep internetowy" Height="700" Width="1300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="60*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="65*"/>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="20*"/>
            </Grid.RowDefinitions>
            
            <Image x:Name="Img" Grid.Row="0" Margin="30" />

			<Border x:Name="BuyBorder" Grid.Row="1" Background="Crimson" BorderBrush="Crimson"
        BorderThickness="2" CornerRadius="20" Margin="80 10">
				<Button x:Name="Buy" Margin="5" Foreground="Wheat" FontSize="15" FontWeight="Bold"
						Click="Buy_Click">
					<Button.Style>
						<Style TargetType="Button">
							<Setter Property="OverridesDefaultStyle" Value="True"/>
							<Setter Property="Background" Value="Crimson"/>
							<Setter Property="BorderBrush" Value="Crimson"/>
							<Setter Property="Foreground" Value="Wheat"/>
							<Setter Property="Padding" Value="5"/>
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="Button">
										<Border Background="{TemplateBinding Background}"
												BorderBrush="{TemplateBinding BorderBrush}"
												BorderThickness="2" CornerRadius="10">
											<ContentPresenter HorizontalAlignment="Center"
															  VerticalAlignment="Center"/>
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="LightCoral"/>
									<Setter Property="BorderBrush" Value="LightCoral"/>
								</Trigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
					Dodaj do koszyka
				</Button>
			</Border>

            <Border Grid.Row="2" BorderBrush="LightBlue" BorderThickness="3" CornerRadius="30" Background="LightBlue" Margin="10">
                <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PreBtn" Grid.Column="0" Background="LightBlue" BorderThickness="0" FontWeight="Bold" Foreground="AliceBlue" FontSize="20" Click="PreBtn_Click">Poprzedni</Button>
                <Button x:Name="NextBtn" Grid.Column="1" Background="LightBlue" BorderThickness="0" FontWeight="Bold" Foreground="AliceBlue" FontSize="20" Click="NextBtn_Click">Następny</Button>
            </Grid>
            </Border>
        </Grid>

		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="1*"/>
				<RowDefinition Height="1*"/>
				<RowDefinition Height="1*"/>
				<RowDefinition Height="7*"/>
			</Grid.RowDefinitions>
			<Grid Grid.Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>

				<TextBlock x:Name="Title" Grid.Row="0" FontSize="50" Text="Przykład" Margin="0 5 10 0"></TextBlock>

				<Border x:Name="cartBtn" Grid.Column="1" HorizontalAlignment="Right" Margin="5" BorderThickness="1" BorderBrush="Black" CornerRadius="10" MouseDown="cartBtn_MouseDown">
					<Image Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" Source="/zdj/cart.jpg"/>
				</Border>
			</Grid>

			<TextBlock x:Name="Price" Grid.Row="1" FontSize="40" FontWeight="Bold" Foreground="Green" Text="Przykład" Margin="0 0"></TextBlock>

			<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0">
				<TextBlock FontSize="20" VerticalAlignment="Center" Margin="0 10 10 0">Kod rabatowy:</TextBlock>
				<TextBox x:Name="DiscountCodeTextBox" FontSize="20" Width="100" VerticalAlignment="Center" Margin="0 15 15 0"/>
				<Button x:Name="ApplyDiscountBtn" Content="Zastosuj" FontSize="16" Click="ApplyDiscountBtn_Click" VerticalAlignment="Center" Margin="0 15 15 0" Padding="3,3"/>
			</StackPanel>

			<TabControl Grid.Row="3" Background="#F6F0F0">
				<TabItem Header="Specyfikacja">
					<StackPanel Margin="10">
						<TextBlock FontSize="30" FontWeight="Bold">Specyfikacja</TextBlock>
						<TextBlock x:Name="Specs" TextWrapping="Wrap" FontSize="15">Przykład</TextBlock>
					</StackPanel>
				</TabItem>

				<TabItem Header="Opis">
					<StackPanel Margin="10">
						<TextBlock TextWrapping="Wrap" FontSize="30" FontWeight="Bold">Opis</TextBlock>
						<TextBlock TextWrapping="Wrap" FontSize="15" x:Name="desc">Przykład</TextBlock>
					</StackPanel>
				</TabItem>
			</TabControl>
		</Grid>

    </Grid>
</Window>